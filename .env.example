# Copy to .env and fill in. All values are optional — every one has a default.

NODE_ENV=development
PORT=3000

# A GitHub personal access token (classic or fine-grained, read-only is enough).
# Without it the GitHub API allows only 60 requests/hour, which the 5-minute
# sync exhausts almost immediately. With it the limit is 5000/hour.
GITHUB_TOKEN=

# Branch the sync reads. Repositories without this branch fall back to their
# own default branch.
SYNC_BRANCH=develop

# How far back the first sync of a repository reaches.
SYNC_LOOKBACK_DAYS=90
